---
import Layout from '@layouts/Layout.astro';
---

<Layout
    title="Exertainment - Your Personal Exercise Coach"
    description="Watch your favorite shows while you work out with Exertainment. Get personalized coaching on your phone and turn entertainment into exercise."
>
    <!-- Hero Section -->
    <section class="relative w-full px-3 py-16 sm:px-6 sm:py-24" data-theme="light">
        <div class="relative mx-auto max-w-7xl text-center">
            <h1 class="text-4xl font-black sm:text-6xl text-balance">
                Your Workout. Your Shows.<br />
                <span class="text-primary">One App.</span>
            </h1>
            <p class="mx-auto mt-6 max-w-2xl text-lg sm:text-xl text-balance">
                Exertainment brings together entertainment and exercise like never before.
                Get a personal exercise coach on your phone so you can watch your favorite shows while you work out.
            </p>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
                <a
                    href="https://exertainment.floot.app"
                    class="btn btn-primary btn-lg"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Try Exertainment Now
                </a>
                <a href="#how-it-works" class="font-bold underline hover:no-underline text-neutral">
                    Learn More
                </a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="w-full px-3 sm:px-6" data-width="inset" id="how-it-works">
        <div class="relative py-16 mx-auto overflow-hidden max-w-7xl rounded-box sm:py-24" data-theme="dark">
            <div class="relative w-10/12 mx-auto">
                <h2 class="text-2xl font-black sm:text-4xl text-center text-balance mb-12">
                    How Exertainment Works
                </h2>
                <div class="grid gap-8 md:grid-cols-3">
                    <div class="card bg-base-200">
                        <div class="card-body text-center">
                            <div class="text-5xl mb-4">📱</div>
                            <h3 class="card-title justify-center text-xl font-bold">Open the App</h3>
                            <p>Launch Exertainment on your phone and choose your workout intensity and duration.</p>
                        </div>
                    </div>
                    <div class="card bg-base-200">
                        <div class="card-body text-center">
                            <div class="text-5xl mb-4">🎬</div>
                            <h3 class="card-title justify-center text-xl font-bold">Pick Your Show</h3>
                            <p>Queue up your favorite streaming content on any device—TV, tablet, or a second screen.</p>
                        </div>
                    </div>
                    <div class="card bg-base-200">
                        <div class="card-body text-center">
                            <div class="text-5xl mb-4">💪</div>
                            <h3 class="card-title justify-center text-xl font-bold">Get Coached</h3>
                            <p>Follow along with your personal exercise coach while enjoying your entertainment.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Benefits Section -->
    <section class="relative w-full px-3 py-16 sm:px-6 sm:py-24" data-theme="light">
        <div class="relative mx-auto max-w-7xl">
            <h2 class="text-2xl font-black sm:text-4xl text-center text-balance mb-12">
                Why You'll Love Exertainment
            </h2>
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                <div class="text-center">
                    <div class="text-4xl mb-4">🏃</div>
                    <h3 class="text-lg font-bold mb-2">Stay Active</h3>
                    <p class="text-sm">Turn binge-watching into productive workout sessions.</p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-4">🎯</div>
                    <h3 class="text-lg font-bold mb-2">Personalized Coaching</h3>
                    <p class="text-sm">Get workouts tailored to your fitness level and goals.</p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-4">📺</div>
                    <h3 class="text-lg font-bold mb-2">Watch Anything</h3>
                    <p class="text-sm">Works with any streaming service or content you love.</p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-4">⏰</div>
                    <h3 class="text-lg font-bold mb-2">Maximize Time</h3>
                    <p class="text-sm">No more choosing between relaxation and exercise.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="w-full px-3 sm:px-6 mb-8 sm:mb-16">
        <div class="relative py-16 mx-auto overflow-hidden max-w-7xl rounded-box sm:py-24" data-theme="dark">
            <div class="relative w-10/12 mx-auto text-center">
                <h2 class="text-2xl font-black sm:text-4xl text-balance">
                    Ready to Transform Your Workouts?
                </h2>
                <p class="mx-auto mt-6 max-w-xl text-lg">
                    Join thousands of users who are making fitness fun with Exertainment.
                    Start your journey today—it's free to get started.
                </p>
                <div class="mt-8">
                    <a
                        href="https://exertainment.floot.app"
                        class="btn btn-primary btn-lg"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Launch Exertainment
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
